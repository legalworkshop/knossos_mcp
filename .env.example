# Knossos MCP — environment template. Copy to .env and fill in. NEVER commit .env.

# Strong random token. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
KNOSSOS_TOKEN=

# Network binding. 0.0.0.0 listens on all interfaces (needed so the client machine can
# reach the server by IP). Lock the port to the client's IP with a Windows firewall rule
# (see scripts/setup-firewall.ps1).
KNOSSOS_HOST=0.0.0.0
KNOSSOS_PORT=8765

# Allowlist of root folders the server may read/write. Semicolon-separated.
# Everything outside these roots is blocked (path traversal is rejected).
# Example (edit to your own paths):
KNOSSOS_ALLOWED_DIRS=C:\path\to\project;D:\another\allowed\dir

# Allowlist of executables run_command may launch. Semicolon-separated.
# Leave EMPTY to allow any binary (NOT recommended).
# NOTE: allowing a general shell (powershell, cmd, bash) effectively lets run_command
# launch anything, since the shell can spawn other programs. Keep this list specific.
KNOSSOS_ALLOWED_BINS=python;ollama;whisper;nvidia-smi

# Per-command timeout, seconds (hard cap; per-call timeouts can be lower, not higher).
KNOSSOS_CMD_TIMEOUT=300

# Max bytes read_file returns by default (protects the agent's context window).
KNOSSOS_MAX_READ_BYTES=5000000

# Enable the delete_path tool. Off by default for safety.
KNOSSOS_ALLOW_DELETE=false
